# DataBridge API Configuration (Safe Example Defaults)
# Copy to .env for local development. Never commit a real .env file.

APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Comma-separated list of allowed browser origins for CORS.
# Never use '*' in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum request payload size in bytes (default: 524288 = 512 KB)
API_MAX_REQUEST_BYTES=524288

# Server-side timeout for connection test execution in seconds
CONNECTION_TEST_TIMEOUT_SECONDS=10.0

# Maximum UTF-8 byte size allowed for transient CSV/JSON fileContent (default: 262144 = 256 KB)
CONNECTION_TEST_MAX_FILE_BYTES=262144

# Maximum response bytes consumed by the REST API tester (default: 65536 = 64 KB)
REST_API_MAX_RESPONSE_BYTES=65536

# Toggle OpenAPI/Swagger documentation endpoints
ENABLE_API_DOCS=true

# PostgreSQL persistence configuration (leave unset for stateless connection testing only)
# Example: postgresql://databridge:change_me@127.0.0.1:5432/databridge
# DATABASE_URL=
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
DATABASE_POOL_TIMEOUT_SECONDS=5.0
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_HEALTH_CHECK_ENABLED=true

# Backend credential encryption (required whenever DATABASE_URL is configured).
# Generate a 32-byte Base64 key with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Example JSON keyring (replace with a secret-manager value, never commit real keys):
# CREDENTIAL_ENCRYPTION_KEYS={"k1":"<base64-encoded-32-byte-key>"}
# CREDENTIAL_ACTIVE_KEY_ID=k1
